{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "web", "tests", "scripts", "App.tsx", "index.ts", "*.config.ts"],
  "exclude": ["node_modules", "scripts/out"]
}
